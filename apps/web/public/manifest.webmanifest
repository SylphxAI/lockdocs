{
  "name": "Lockdocs",
  "short_name": "Lockdocs",
  "description": "Look up exact versions from a lockfile and preview what changes when you upgrade.",
  "start_url": "/playground",
  "scope": "/",
  "display": "standalone",
  "background_color": "#06080C",
  "theme_color": "#06080C",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
