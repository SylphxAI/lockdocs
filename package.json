{
  "name": "lockdocs-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "lockdocs monorepo: Rust engine (crates/), npm packages (packages/), docs (docs/), benchmark (bench/).",
  "homepage": "https://sylphxai.github.io/lockdocs/",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "cargo build --release -p lockdocs",
    "test": "cargo test --workspace",
    "version:set": "bun scripts/set-version.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@vue/compiler-dom": "3.5.43",
    "@vue/server-renderer": "3.5.43",
    "vitepress": "1.6.4",
    "vue": "3.5.43"
  }
}
